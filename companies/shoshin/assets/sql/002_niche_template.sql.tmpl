-- Shoshin Knowledge Base - Niche Schema Template
-- Apply with:
--   env project_slug=shoshin niche_slug=world-mobile niche_schema=world_mobile \
--       niche_name="World Mobile" compliance_posture="third-party-creator" \
--       envsubst < 002_niche_template.sql.tmpl | psql $DATABASE_URL
-- Idempotent: safe to re-run.

-- Register niche in public registry
INSERT INTO public.niches (slug, schema_name, name, compliance_posture)
VALUES ('${niche_slug}', '${niche_schema}', '${niche_name}', '${compliance_posture}')
ON CONFLICT (slug) DO NOTHING;

-- Create niche schema
CREATE SCHEMA IF NOT EXISTS ${niche_schema};

-- Knowledge items table (one row per ingested source item)
CREATE TABLE IF NOT EXISTS ${niche_schema}.knowledge_items (
  id BIGSERIAL PRIMARY KEY,
  source_type TEXT NOT NULL,
  source_identifier TEXT NOT NULL,
  source_url TEXT,
  niche_slug TEXT NOT NULL DEFAULT '${niche_slug}',
  captured_at TIMESTAMPTZ NOT NULL,
  published_at TIMESTAMPTZ,
  engagement_signals JSONB NOT NULL DEFAULT '{}',
  extracted_hooks JSONB NOT NULL DEFAULT '[]',
  extracted_quotes JSONB NOT NULL DEFAULT '[]',
  tags TEXT[] NOT NULL DEFAULT '{}',
  provenance JSONB NOT NULL,
  content_hash TEXT,
  body_text TEXT,
  md_projected_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  CONSTRAINT ${niche_schema}_knowledge_items_source_unique UNIQUE (source_type, source_identifier)
);

-- Indexes for common query patterns
CREATE INDEX IF NOT EXISTS ${niche_schema}_ki_source_type_captured_at
  ON ${niche_schema}.knowledge_items (source_type, captured_at DESC);

CREATE INDEX IF NOT EXISTS ${niche_schema}_ki_tags_gin
  ON ${niche_schema}.knowledge_items USING GIN (tags);

-- Roles (project-prefixed to avoid collisions on shared clusters)
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${project_slug}_${niche_schema}_rw') THEN
    CREATE ROLE ${project_slug}_${niche_schema}_rw NOLOGIN;
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${project_slug}_${niche_schema}_ro') THEN
    CREATE ROLE ${project_slug}_${niche_schema}_ro NOLOGIN;
  END IF;
END
$$;

-- Grant permissions
GRANT USAGE ON SCHEMA ${niche_schema} TO ${project_slug}_${niche_schema}_rw;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA ${niche_schema} TO ${project_slug}_${niche_schema}_rw;
GRANT USAGE ON ALL SEQUENCES IN SCHEMA ${niche_schema} TO ${project_slug}_${niche_schema}_rw;

GRANT USAGE ON SCHEMA ${niche_schema} TO ${project_slug}_${niche_schema}_ro;
GRANT SELECT ON ALL TABLES IN SCHEMA ${niche_schema} TO ${project_slug}_${niche_schema}_ro;

-- Record this migration
INSERT INTO public.schema_migrations (version)
VALUES ('002_${project_slug}_niche_${niche_slug}')
ON CONFLICT (version) DO NOTHING;
